# Copy to .env and fill in. See README "Gemini setup" for details.

# Required for any Agent/Orchestrator reasoning call (SPEC §11: Real, not mocked).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: pins a specific Gemini model version. Defaults to a concrete,
# versioned model (not a "-latest" alias) if unset — see app/gemini_client.py.
# GEMINI_MODEL=gemini-2.5-flash
