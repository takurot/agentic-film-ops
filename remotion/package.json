{
  "name": "agentic-film-ops-remotion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts PromoVideo out/promo-video.mp4 --concurrency=4",
    "render:silent": "remotion render src/index.ts PromoVideo out/promo-video-silent.mp4 --props='{\"enableAudio\":false}' --concurrency=4",
    "render:smoke": "remotion render src/index.ts PromoVideo out/smoke.mp4 --frames=0-15 --props='{\"enableAudio\":false}' --concurrency=1",
    "test": "vitest run",
    "lint": "eslint ."

  },
  "dependencies": {
    "@remotion/bundler": "^4.0.267",
    "@remotion/cli": "^4.0.267",
    "@remotion/media-utils": "^4.0.267",
    "@remotion/tailwind-v4": "^4.0.267",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reactflow": "^11.11.4",
    "remotion": "^4.0.267"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.10"
  }
}
